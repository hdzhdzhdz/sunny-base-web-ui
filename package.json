{
  "name": "vue3-monorepo-starter",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "docs",
    "packages/*",
    "packages/@config/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:packages": "turbo run build --filter=\"./packages/**\"",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "changeset": "changeset",
    "publish:packages": "node ./scripts/publish-packages.mjs",
    "version-packages": "changeset version",
    "release": "pnpm build:packages && changeset publish",
    "generate:llms": "npx tsx scripts/generate-llms-docs.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "prettier": "^3.2.5",
    "ts-morph": "^27.0.2",
    "turbo": "^2.3.3",
    "typescript": "^5.2.2"
  },
  "packageManager": "pnpm@9.15.0",
  "dependencies": {
    "lodash-es": "^4.17.23"
  }
}

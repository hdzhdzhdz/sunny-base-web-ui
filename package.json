{
  "name": "vue3-monorepo-starter",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "docs",
    "packages/*",
    "packages/@config/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "prettier": "^3.2.5",
    "turbo": "^2.3.3",
    "typescript": "^5.2.2"
  },
  "packageManager": "pnpm@9.15.0",
  "dependencies": {
    "lodash-es": "^4.17.23"
  }
}

{
  "extends": "@sunny-base-web/tsconfig/base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "lib": ["ESNext", "DOM"],
    "module": "ESNext",
    "target": "ESNext",
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "paths": {
      "@sunny-base-web/ui": ["../packages/@ui/src/index.ts"],
      "@sunny-base-web/effects": ["../packages/@effects/src/index.ts"],
      "@sunny-base-web/utils": ["../packages/@utils/src/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts", 
    "src/**/*.d.ts", 
    "src/**/*.tsx", 
    "src/**/*.vue", 
    "src/**/*.md"
  ]
}

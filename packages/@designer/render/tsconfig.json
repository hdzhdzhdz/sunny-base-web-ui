{
  "extends": "@sunny-base-web/tsconfig/base.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "module": "ESNext",
    "target": "ESNext",
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "moduleResolution": "bundler",
    "noEmit": true,
    "strict": true,
    "paths": {
      "@sunny-base-web/designer-core": ["../core/src/index.ts"],
      "@sunny-base-web/designer-materials": ["../materials/src/index.ts"]
    }
  },
  "include": ["src"]
}

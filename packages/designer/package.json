{
  "name": "@sunny-base-web/designer",
  "version": "0.1.0",
  "private": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./style.css": "./src/style.css"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.mjs",
        "require": "./dist/index.js"
      },
      "./style.css": "./dist/designer.css"
    },
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vite build",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore"
  },
  "dependencies": {
    "@arco-design/web-vue": "catalog:",
    "@sunny-base-web/icons": "workspace:^",
    "@sunny-base-web/locales": "workspace:^",
    "@sunny-base-web/ui": "workspace:^",
    "@sunny-base-web/utils": "workspace:^",
    "vue": "catalog:",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@sunny-base-web/tsconfig": "workspace:*",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vitejs/plugin-vue-jsx": "^5.1.4",
    "typescript": "catalog:",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4",
    "vue-tsc": "catalog:"
  }
}

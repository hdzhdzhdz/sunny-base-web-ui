{
  "name": "@sunny-base-web/constants",
  "version": "0.8.56",
  "private": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "type": "module",
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean"
  },
  "devDependencies": {
    "@sunny-base-web/tsconfig": "workspace:*",
    "tsup": "^8.5.1",
    "typescript": "catalog:",
    "vite": "^7.3.1"
  }
}

        "import": "./dist/index.mjs",
        "require": "./dist/index.js"
      },
      "./style.css": "./dist/ui.css"
    },
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vite build",

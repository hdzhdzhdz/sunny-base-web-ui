  },
  "dependencies": {
    "@arco-design/web-vue": "^2.57.0",
    "@sunny-base-web/icons": "workspace:*",
    "@sunny-base-web/utils": "workspace:*",
    "@tanstack/store": "^0.8.0",
    "@tanstack/vue-store": "^0.8.0",
    "@vee-validate/zod": "^4.15.1",
    "@vueuse/core": "catalog:",
    "axios": "^1.13.2",
    "nprogress": "^0.2.0",
    "reka-ui": "catalog:",
    "vee-validate": "^4.15.1",
    "vue": "catalog:",
    "vxe-pc-ui": "^4.8.0",
    "vxe-table": "^4.17.44",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@sunny-base-web/tailwind-config": "workspace:*",

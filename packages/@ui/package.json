{
  "name": "@sunny-base-web/ui",
  "version": "0.8.0",
  "private": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./style.css": "./src/style.css"

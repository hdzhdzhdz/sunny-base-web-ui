{
  "extends": "@config/tsconfig/base.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "module": "ESNext",
    "target": "ESNext",
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@kunkka/ui": ["../@kunkka/src/index.ts"],
      "@utils": ["../@utils/src/index.ts"],
      "@icons": ["../@icons/src/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.tsx",
    "src/**/*.vue"
  ]
}

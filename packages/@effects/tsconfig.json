{
  "extends": "@sunny-base-web/tsconfig/base.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "module": "ESNext",
    "target": "ESNext",
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@sunny-base-web/ui": ["../@kunkka/src/index.ts"],
      "@sunny-base-web/utils": ["../@utils/src/index.ts"],
      "@sunny-base-web/icons": ["../@sunny-base-web/icons/src/index.ts"],
      "@sunny-base-web/constants": ["../@config/constants/src/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.tsx",
    "src/**/*.vue"
  ]
}

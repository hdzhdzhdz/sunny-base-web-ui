{
  "extends": "@sunny-base-web/tsconfig/base.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "module": "ESNext",
    "target": "ESNext",
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "skipLibCheck": true,
    "paths": {
      "@sunny-base-web/ui": ["../@ui/src/index.ts"],
      "@sunny-base-web/utils": ["../@utils/src/index.ts"],
      "@sunny-base-web/icons": ["../@icons/src/index.ts"],
      "@sunny-base-web/constants": ["../@config/constants/src/index.ts"],
      "@sunny-base-web/locales": ["../@locales/src/index.ts"],
      "@sunny-base-web/designer-core": ["../designer/core/src/index.ts"],
      "@sunny-base-web/designer-studio": ["../designer/studio/src/index.ts"],
      "@sunny-base-web/designer-materials": ["../designer/materials/src/index.ts"],
      "@sunny-base-web/designer-render": ["../designer/render/src/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "src/vite-env.d.ts"
  ],
  "esModuleInterop": true
}
